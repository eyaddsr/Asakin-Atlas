{
  "name": "asakin-integration-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Asakin Systems Integration Map (technical team only)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \"data/**\" server/index.ts",
    "build": "vite build",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "data:import": "tsx scripts/import.ts",
    "data:validate": "tsx scripts/validate.ts",
    "data:diff": "tsx scripts/diff.ts",
    "data:promote": "tsx scripts/promote.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run data:validate && npm run test && npm run build && tsx scripts/check-dist.ts",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "4.23.15",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
